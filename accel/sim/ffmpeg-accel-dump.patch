+/* MiSTer MediaCenter FPGA accelerator: deblocking parameters of a macroblock
+ * (h264_mcdbk.c), noted by the edge functions of the loop filter */
+struct mc_dbk {
+    const uint8_t *y, *cb, *cr;    // where the macroblock "is" (never touched)
+    ptrdiff_t ls, uvls;
+    uint8_t bs[2][4][4];           // luma: [0 vertical, 1 horizontal edges][edge][segment], 4 = strong
+    uint8_t cbs[2][2][2][4];       // chroma: [Cb, Cr][direction][edge][segment]
+    int8_t qp[3][3];               // [Y, Cb, Cr][0 left edge, 1 top edge, 2 inside], -1 none
+    int a, b, n, bad;
+};
+void ff_h264_mcdbk_edge(struct mc_dbk *d, const uint8_t *pix, int kind,
+                        const int16_t bS[4], int qp, int a, int b, int intra);
 
 int ff_h264_ref_picture(H264Picture *dst, const H264Picture *src);
 int ff_h264_replace_picture(H264Picture *dst, const H264Picture *src);
