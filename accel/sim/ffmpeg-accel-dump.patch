diff -ruN a/libavcodec/h264_accdump.c b/libavcodec/h264_accdump.c
--- a/libavcodec/h264_accdump.c
+++ b/libavcodec/h264_accdump.c
@@ -0,0 +1,188 @@
+/* MiSTer MediaCenter FPGA accelerator, phase 1 test bench only (host build):
+ * with MC_ACCDUMP=<prefix> the H.264 decoder writes, for every picture, the
+ * commands the ARM would send to the FPGA (<prefix>.cmd, 32-bit words, see
+ * accel/doc/comandi.md) and the picture it rebuilt (<prefix>.rec). Frame
+ * pictures, 8-bit 4:2:0 only. With deblocking on (accdump -d) the macroblock
+ * commands are preceded by A5 and <prefix>.rec holds the deblocked pictures. */
+#include <stdio.h>
+#include <stdlib.h>
+
+static FILE *acc_cmd, *acc_rec;
+static int acc_state = -1, acc_pic_open;
+
+static int acc_on(void)
+{
+    if (acc_state <= 0) { // set by accdump after probing the file
+        const char *p = getenv("MC_ACCDUMP");
+        acc_state = 0;
+        if (p && *p) {
+            char name[1024];
+            snprintf(name, sizeof(name), "%s.cmd", p);
+            acc_cmd = fopen(name, "wb");
+            snprintf(name, sizeof(name), "%s.rec", p);
+            acc_rec = fopen(name, "wb");
+            acc_state = acc_cmd && acc_rec;
+        }
+    }
+    return acc_state;
+}
+
+static void acc_w(uint32_t w)
+{
+    fwrite(&w, 4, 1, acc_cmd);
+}
+
+static int acc_slot(const H264Context *h, const H264Picture *p)
+{
+    return p ? (int)(p - h->DPB) : 255;
+}
+
+static void acc_slice(const H264Context *h, const H264SliceContext *sl)
+{
+    if (!acc_on())
+        return;
+    if (FIELD_OR_MBAFF_PICTURE(h) || h->pixel_shift || h->ps.sps->chroma_format_idc != 1) {
+        fprintf(stderr, "accdump: only progressive 8-bit 4:2:0 frames\n");
+        exit(1);
+    }
+    if (!acc_pic_open) {
+        acc_pic_open = 1;
+        acc_w(0xA1000000u | acc_slot(h, h->cur_pic_ptr));
+        acc_w(h->mb_width | h->mb_height << 8);
+    }
+    // slice: reference lists with weights
+    acc_w(0xA2000000u | sl->ref_count[0] | sl->ref_count[1] << 6 |
+          (sl->list_count > 1) << 12 | sl->pwt.use_weight << 13 | sl->pwt.use_weight_chroma << 15 |
+          sl->pwt.luma_log2_weight_denom << 16 | sl->pwt.chroma_log2_weight_denom << 20);
+    for (int l = 0; l < sl->list_count; l++)
+        for (unsigned i = 0; i < sl->ref_count[l]; i++) {
+            const H264Ref *r = &sl->ref_list[l][i];
+            // weights are 9 bits (the default 1 << denom can be 128), offsets 8
+            acc_w(acc_slot(h, r->parent) | (sl->pwt.luma_weight[i][l][0] & 0x1FF) << 8 |
+                  (sl->pwt.luma_weight[i][l][1] & 0xFF) << 17);
+            acc_w((sl->pwt.chroma_weight[i][l][0][0] & 0x1FF) | (sl->pwt.chroma_weight[i][l][0][1] & 0xFF) << 9);
+            acc_w((sl->pwt.chroma_weight[i][l][1][0] & 0x1FF) | (sl->pwt.chroma_weight[i][l][1][1] & 0xFF) << 9);
+        }
+}
+
+static void acc_mb(const H264Context *h, H264SliceContext *sl)
+{
+    if (!acc_on())
+        return;
+    const int mb_type = h->cur_pic.mb_type[sl->mb_xy];
+    int type, i;
+    int16_t blk[16 * 16 * 3];
+    memcpy(blk, sl->mb, sizeof(blk));
+
+    if (IS_INTRA_PCM(mb_type)) type = 4;
+    else if (IS_INTRA16x16(mb_type)) type = 3;
+    else if (IS_INTRA4x4(mb_type)) type = IS_8x8DCT(mb_type) ? 2 : 1;
+    else type = 0;
+    // deblocking (only when FFmpeg deblocks, accdump -d): the parameters are
+    // worked out as the player does, on a copy of the slice state (the
+    // capture overwrites the caches the pixel rebuild still needs)
+    if (sl->deblocking_filter) {
+        static H264SliceContext save;
+        uint32_t dw[5];
+        int bad, have;
+        memcpy(&save, sl, sizeof(save));
+        have = mcacc_dbk(h, sl, dw, &bad);
+        memcpy(sl, &save, sizeof(save));
+        if (bad) {
+            fprintf(stderr, "accdump: deblocking does not fit the command (mb %d %d)\n", sl->mb_x, sl->mb_y);
+            exit(1);
+        }
+        if (have)
+            for (i = 0; i < 5; i++)
+                acc_w(dw[i]);
+    }
+    acc_w(0xA3000000u | type << 16 | sl->mb_y << 8 | sl->mb_x);
+    if (type == 4) {
+        for (i = 0; i < 384; i += 4)
+            acc_w(AV_RL32(sl->intra_pcm_ptr + i));
+        return;
+    }
+    // the DC transforms FFmpeg does while rebuilding (cheap, done by the ARM)
+    if (type == 3 && sl->non_zero_count_cache[scan8[LUMA_DC_BLOCK_INDEX]])
+        h->h264dsp.h264_luma_dc_dequant_idct(blk, sl->mb_luma_dc[0],
+                                             h->ps.pps->dequant4_coeff[0][sl->qscale][0]);
+    if (sl->cbp & 0x30) {
+        if (sl->non_zero_count_cache[scan8[CHROMA_DC_BLOCK_INDEX + 0]])
+            h->h264dsp.h264_chroma_dc_dequant_idct(blk + 256, h->ps.pps->dequant4_coeff[IS_INTRA(mb_type) ? 1 : 4][sl->chroma_qp[0]][0]);
+        if (sl->non_zero_count_cache[scan8[CHROMA_DC_BLOCK_INDEX + 1]])
+            h->h264dsp.h264_chroma_dc_dequant_idct(blk + 512, h->ps.pps->dequant4_coeff[IS_INTRA(mb_type) ? 2 : 5][sl->chroma_qp[1]][0]);
+    } else {
+        memset(blk + 256, 0, 512 * sizeof(int16_t));
+    }
+    if (!IS_INTRA(mb_type) && !(sl->cbp & 15))
+        memset(blk, 0, 256 * sizeof(int16_t));
+
+    // coefficients, in the standard raster order (FFmpeg keeps them transposed)
+    uint32_t coef[384];
+    int n = 0, mask = 0, t8 = IS_8x8DCT(mb_type) ? 1 : 0;
+    for (int b = 0; b < 24; b++) {
+        int c0 = b < 16 ? b * 16 : (b < 20 ? 256 + (b - 16) * 16 : 512 + (b - 20) * 16);
+        if (b < 16 && t8) {
+            if (b & 3) continue;
+            for (int p = 0; p < 64; p++) {
+                int v = blk[b * 16 + ((p & 7) << 3 | p >> 3)];
+                if (v) { coef[n++] = (v & 0xFFFF) | p << 16 | b << 22; mask |= 1 << b; }
+            }
+        } else {
+            for (int p = 0; p < 16; p++) {
+                int v = blk[c0 + ((p & 3) << 2 | p >> 2)];
+                if (v) { coef[n++] = (v & 0xFFFF) | p << 16 | b << 22; mask |= 1 << b; }
+            }
+        }
+    }
+    acc_w(mask | t8 << 24);
+    if (IS_INTRA(mb_type)) {
+        uint32_t m0 = 0, m1 = 0;
+        for (i = 0; i < 8; i++) m0 |= (sl->intra4x4_pred_mode_cache[scan8[i]] & 15) << (4 * i);
+        for (i = 0; i < 8; i++) m1 |= (sl->intra4x4_pred_mode_cache[scan8[i + 8]] & 15) << (4 * i);
+        if (type == 3) m0 = m1 = 0;
+        acc_w(m0);
+        acc_w(m1);
+        acc_w((sl->topright_samples_available & 0xFFFF) | (sl->topleft_samples_available & 0xFFFF) << 16);
+        acc_w(sl->chroma_pred_mode | (type == 3 ? sl->intra16x16_pred_mode : 0) << 4);
+    } else {
+        uint32_t refs = 0;
+        for (i = 0; i < 4; i++) {
+            int r0 = USES_LIST(mb_type, 0) ? sl->ref_cache[0][scan8[i * 4]] : -1;
+            int r1 = sl->list_count > 1 && USES_LIST(mb_type, 1) ? sl->ref_cache[1][scan8[i * 4]] : -1;
+            refs |= ((r0 & 0x3F) | (r0 < 0) << 6 | (uint32_t)((r1 & 0x3F) | (r1 < 0) << 6) << 7) << 0;
+            // both lists with implicit weights: weight of list 0 (list 1 is 64 - it)
+            if (r0 >= 0 && r1 >= 0 && sl->pwt.use_weight == 2)
+                refs |= (uint32_t)(sl->pwt.implicit_weight[r0][r1][sl->mb_y & 1] & 0x1FF) << 16;
+            else
+                refs |= 32u << 16;
+            acc_w(refs), refs = 0;
+        }
+        for (int l = 0; l < 2; l++)
+            for (i = 0; i < 16; i++) {
+                int ok = l < sl->list_count && USES_LIST(mb_type, l);
+                acc_w(ok ? (sl->mv_cache[l][scan8[i]][0] & 0xFFFF) | (uint32_t)sl->mv_cache[l][scan8[i]][1] << 16 : 0);
+            }
+    }
+    acc_w(n);
+    for (i = 0; i < n; i++)
+        acc_w(coef[i]);
+}
+
+void ff_h264_accdump_pic_end(const H264Context *h)
+{
+    if (!acc_on() || !acc_pic_open)
+        return;
+    acc_pic_open = 0;
+    acc_w(0xA4000000u);
+    const AVFrame *f = h->cur_pic.f;
+    uint32_t hdr[3] = { acc_slot(h, h->cur_pic_ptr), h->mb_width * 16, h->mb_height * 16 };
+    fwrite(hdr, 4, 3, acc_rec);
+    for (int p = 0; p < 3; p++) {
+        int w = hdr[1] >> !!p, hh = hdr[2] >> !!p;
+        for (int y = 0; y < hh; y++)
+            fwrite(f->data[p] + (size_t)y * f->linesize[p], 1, w, acc_rec);
+    }
+    fflush(acc_cmd);
+    fflush(acc_rec);
+}
