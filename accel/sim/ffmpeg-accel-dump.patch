diff -ruN a/libavcodec/h264_accdump.c b/libavcodec/h264_accdump.c
--- a/libavcodec/h264_accdump.c	1970-01-01 00:00:00.000000000 +0000
+++ b/libavcodec/h264_accdump.c	2026-10-25 16:29:40.521260276 +0000
@@ -0,0 +1,188 @@
+/* MiSTer MediaCenter FPGA accelerator, phase 1 test bench only (host build):
+ * with MC_ACCDUMP=<prefix> the H.264 decoder writes, for every picture, the
+ * commands the ARM would send to the FPGA (<prefix>.cmd, 32-bit words, see
+ * accel/doc/comandi.md) and the picture it rebuilt (<prefix>.rec). Frame
+ * pictures, 8-bit 4:2:0 only. With deblocking on (accdump -d) the macroblock
+ * commands are preceded by A5 and <prefix>.rec holds the deblocked pictures. */
+#include <stdio.h>
+#include <stdlib.h>
+
+static FILE *acc_cmd, *acc_rec;
+static int acc_state = -1, acc_pic_open;
+
+static int acc_on(void)
+{
+    if (acc_state <= 0) { // set by accdump after probing the file
+        const char *p = getenv("MC_ACCDUMP");
+        acc_state = 0;
+        if (p && *p) {
+            char name[1024];
+            snprintf(name, sizeof(name), "%s.cmd", p);
+            acc_cmd = fopen(name, "wb");
+            snprintf(name, sizeof(name), "%s.rec", p);
+            acc_rec = fopen(name, "wb");
+            acc_state = acc_cmd && acc_rec;
+        }
+    }
+    return acc_state;
+}
+
+static void acc_w(uint32_t w)
+{
+    fwrite(&w, 4, 1, acc_cmd);
+}
+
+static int acc_slot(const H264Context *h, const H264Picture *p)
+{
+    return p ? (int)(p - h->DPB) : 255;
+}
+
+static void acc_slice(const H264Context *h, const H264SliceContext *sl)
+{
+    if (!acc_on())
+        return;
+    if (FIELD_OR_MBAFF_PICTURE(h) || h->pixel_shift || h->ps.sps->chroma_format_idc != 1) {
+        fprintf(stderr, "accdump: only progressive 8-bit 4:2:0 frames\n");
+        exit(1);
+    }
+    if (!acc_pic_open) {
+        acc_pic_open = 1;
+        acc_w(0xA1000000u | acc_slot(h, h->cur_pic_ptr));
+        acc_w(h->mb_width | h->mb_height << 8);
+    }
+    // slice: reference lists with weights
+    acc_w(0xA2000000u | sl->ref_count[0] | sl->ref_count[1] << 6 |
+          (sl->list_count > 1) << 12 | sl->pwt.use_weight << 13 | sl->pwt.use_weight_chroma << 15 |
+          sl->pwt.luma_log2_weight_denom << 16 | sl->pwt.chroma_log2_weight_denom << 20);
+    for (int l = 0; l < sl->list_count; l++)
+        for (unsigned i = 0; i < sl->ref_count[l]; i++) {
+            const H264Ref *r = &sl->ref_list[l][i];
+            // weights are 9 bits (the default 1 << denom can be 128), offsets 8
+            acc_w(acc_slot(h, r->parent) | (sl->pwt.luma_weight[i][l][0] & 0x1FF) << 8 |
+                  (sl->pwt.luma_weight[i][l][1] & 0xFF) << 17);
+            acc_w((sl->pwt.chroma_weight[i][l][0][0] & 0x1FF) | (sl->pwt.chroma_weight[i][l][0][1] & 0xFF) << 9);
+            acc_w((sl->pwt.chroma_weight[i][l][1][0] & 0x1FF) | (sl->pwt.chroma_weight[i][l][1][1] & 0xFF) << 9);
+        }
+}
+
+static void acc_mb(const H264Context *h, H264SliceContext *sl)
+{
+    if (!acc_on())
+        return;
+    const int mb_type = h->cur_pic.mb_type[sl->mb_xy];
+    int type, i;
+    int16_t blk[16 * 16 * 3];
+    memcpy(blk, sl->mb, sizeof(blk));
+
+    if (IS_INTRA_PCM(mb_type)) type = 4;
+    else if (IS_INTRA16x16(mb_type)) type = 3;
+    else if (IS_INTRA4x4(mb_type)) type = IS_8x8DCT(mb_type) ? 2 : 1;
+    else type = 0;
+    // deblocking (only when FFmpeg deblocks, accdump -d): the parameters are
+    // worked out as the player does, on a copy of the slice state (the loop
+    // filter's caches overwrite those the pixel rebuild still needs)
+    if (sl->deblocking_filter) {
+        static H264SliceContext save;
+        uint32_t dw[5];
+        int bad, have;
+        memcpy(&save, sl, sizeof(save));
+        have = mcacc_dbk(h, sl, dw, &bad);
+        memcpy(sl, &save, sizeof(save));
+        if (bad) {
+            fprintf(stderr, "accdump: deblocking does not fit the command (mb %d %d)\n", sl->mb_x, sl->mb_y);
+            exit(1);
+        }
+        if (have)
+            for (i = 0; i < 5; i++)
+                acc_w(dw[i]);
+    }
+    acc_w(0xA3000000u | type << 16 | sl->mb_y << 8 | sl->mb_x);
+    if (type == 4) {
+        for (i = 0; i < 384; i += 4)
+            acc_w(AV_RL32(sl->intra_pcm_ptr + i));
+        return;
+    }
+    // the DC transforms FFmpeg does while rebuilding (cheap, done by the ARM)
+    if (type == 3 && sl->non_zero_count_cache[scan8[LUMA_DC_BLOCK_INDEX]])
+        h->h264dsp.h264_luma_dc_dequant_idct(blk, sl->mb_luma_dc[0],
+                                             h->ps.pps->dequant4_coeff[0][sl->qscale][0]);
+    if (sl->cbp & 0x30) {
+        if (sl->non_zero_count_cache[scan8[CHROMA_DC_BLOCK_INDEX + 0]])
+            h->h264dsp.h264_chroma_dc_dequant_idct(blk + 256, h->ps.pps->dequant4_coeff[IS_INTRA(mb_type) ? 1 : 4][sl->chroma_qp[0]][0]);
+        if (sl->non_zero_count_cache[scan8[CHROMA_DC_BLOCK_INDEX + 1]])
+            h->h264dsp.h264_chroma_dc_dequant_idct(blk + 512, h->ps.pps->dequant4_coeff[IS_INTRA(mb_type) ? 2 : 5][sl->chroma_qp[1]][0]);
+    } else {
+        memset(blk + 256, 0, 512 * sizeof(int16_t));
+    }
+    if (!IS_INTRA(mb_type) && !(sl->cbp & 15))
+        memset(blk, 0, 256 * sizeof(int16_t));
+
+    // coefficients, in the standard raster order (FFmpeg keeps them transposed)
+    uint32_t coef[384];
+    int n = 0, mask = 0, t8 = IS_8x8DCT(mb_type) ? 1 : 0;
+    for (int b = 0; b < 24; b++) {
+        int c0 = b < 16 ? b * 16 : (b < 20 ? 256 + (b - 16) * 16 : 512 + (b - 20) * 16);
+        if (b < 16 && t8) {
+            if (b & 3) continue;
+            for (int p = 0; p < 64; p++) {
+                int v = blk[b * 16 + ((p & 7) << 3 | p >> 3)];
+                if (v) { coef[n++] = (v & 0xFFFF) | p << 16 | b << 22; mask |= 1 << b; }
+            }
+        } else {
+            for (int p = 0; p < 16; p++) {
+                int v = blk[c0 + ((p & 3) << 2 | p >> 2)];
+                if (v) { coef[n++] = (v & 0xFFFF) | p << 16 | b << 22; mask |= 1 << b; }
+            }
+        }
+    }
+    acc_w(mask | t8 << 24);
+    if (IS_INTRA(mb_type)) {
+        uint32_t m0 = 0, m1 = 0;
+        for (i = 0; i < 8; i++) m0 |= (sl->intra4x4_pred_mode_cache[scan8[i]] & 15) << (4 * i);
+        for (i = 0; i < 8; i++) m1 |= (sl->intra4x4_pred_mode_cache[scan8[i + 8]] & 15) << (4 * i);
+        if (type == 3) m0 = m1 = 0;
+        acc_w(m0);
+        acc_w(m1);
+        acc_w((sl->topright_samples_available & 0xFFFF) | (sl->topleft_samples_available & 0xFFFF) << 16);
+        acc_w(sl->chroma_pred_mode | (type == 3 ? sl->intra16x16_pred_mode : 0) << 4);
+    } else {
+        uint32_t refs = 0;
+        for (i = 0; i < 4; i++) {
+            int r0 = USES_LIST(mb_type, 0) ? sl->ref_cache[0][scan8[i * 4]] : -1;
+            int r1 = sl->list_count > 1 && USES_LIST(mb_type, 1) ? sl->ref_cache[1][scan8[i * 4]] : -1;
+            refs |= ((r0 & 0x3F) | (r0 < 0) << 6 | (uint32_t)((r1 & 0x3F) | (r1 < 0) << 6) << 7) << 0;
+            // both lists with implicit weights: weight of list 0 (list 1 is 64 - it)
+            if (r0 >= 0 && r1 >= 0 && sl->pwt.use_weight == 2)
+                refs |= (uint32_t)(sl->pwt.implicit_weight[r0][r1][sl->mb_y & 1] & 0x1FF) << 16;
+            else
+                refs |= 32u << 16;
+            acc_w(refs), refs = 0;
+        }
+        for (int l = 0; l < 2; l++)
+            for (i = 0; i < 16; i++) {
+                int ok = l < sl->list_count && USES_LIST(mb_type, l);
+                acc_w(ok ? (sl->mv_cache[l][scan8[i]][0] & 0xFFFF) | (uint32_t)sl->mv_cache[l][scan8[i]][1] << 16 : 0);
+            }
+    }
+    acc_w(n);
+    for (i = 0; i < n; i++)
+        acc_w(coef[i]);
+}
+
+void ff_h264_accdump_pic_end(const H264Context *h)
+{
+    if (!acc_on() || !acc_pic_open)
+        return;
+    acc_pic_open = 0;
+    acc_w(0xA4000000u);
+    const AVFrame *f = h->cur_pic.f;
+    uint32_t hdr[3] = { acc_slot(h, h->cur_pic_ptr), h->mb_width * 16, h->mb_height * 16 };
+    fwrite(hdr, 4, 3, acc_rec);
+    for (int p = 0; p < 3; p++) {
+        int w = hdr[1] >> !!p, hh = hdr[2] >> !!p;
+        for (int y = 0; y < hh; y++)
+            fwrite(f->data[p] + (size_t)y * f->linesize[p], 1, w, acc_rec);
+    }
+    fflush(acc_cmd);
+    fflush(acc_rec);
+}
diff -ruN a/libavcodec/h264_mcdbk.c b/libavcodec/h264_mcdbk.c
--- a/libavcodec/h264_mcdbk.c	1970-01-01 00:00:00.000000000 +0000
+++ b/libavcodec/h264_mcdbk.c	2026-10-25 16:29:40.537222857 +0000
@@ -0,0 +1,159 @@
+/* MiSTer MediaCenter FPGA accelerator: the deblocking parameters of one
+ * macroblock, for the FPGA command A5 (accel/doc/comandi.md in the MiSTer
+ * MediaCenter repository). Included by h264_slice.c after loop_filter().
+ *
+ * The strengths and qp are worked out as ff_h264_filter_mb() does for a
+ * progressive frame (no MBAFF, 4:2:0, 8 bit), from the loop filter's caches
+ * (fill_filter_caches), without filtering: the FPGA filters with exactly the
+ * values FFmpeg would use. The decoding caches of the slice are overwritten,
+ * as between two macroblock rows of a normal decode: call it after the
+ * macroblock's commands are written. */
+
+// check_mv of h264_loopfilter.c (1 if the two 4x4 blocks predict differently)
+static av_always_inline int mcdbk_mv(const H264SliceContext *sl, int b, int bn)
+{
+    int v = sl->ref_cache[0][b] != sl->ref_cache[0][bn];
+    if (!v && sl->ref_cache[0][b] != -1)
+        v = sl->mv_cache[0][b][0] - sl->mv_cache[0][bn][0] + 3 >= 7U |
+            FFABS(sl->mv_cache[0][b][1] - sl->mv_cache[0][bn][1]) >= 4;
+    if (sl->list_count == 2) {
+        if (!v)
+            v = sl->ref_cache[1][b] != sl->ref_cache[1][bn] |
+                sl->mv_cache[1][b][0] - sl->mv_cache[1][bn][0] + 3 >= 7U |
+                FFABS(sl->mv_cache[1][b][1] - sl->mv_cache[1][bn][1]) >= 4;
+        if (v) {
+            if (sl->ref_cache[0][b] != sl->ref_cache[1][bn] |
+                sl->ref_cache[1][b] != sl->ref_cache[0][bn])
+                return 1;
+            return sl->mv_cache[0][b][0] - sl->mv_cache[1][bn][0] + 3 >= 7U |
+                   FFABS(sl->mv_cache[0][b][1] - sl->mv_cache[1][bn][1]) >= 4 |
+                   sl->mv_cache[1][b][0] - sl->mv_cache[0][bn][0] + 3 >= 7U |
+                   FFABS(sl->mv_cache[1][b][1] - sl->mv_cache[0][bn][1]) >= 4;
+        }
+    }
+    return v;
+}
+
+/* The macroblock just read (sl->mb_xy): returns 1 and the 5 words of the
+ * command A5 if it has edges to filter, 0 if not. *bad is set when the
+ * stream does not fit the command (the macroblock is then left unfiltered). */
+static int mcacc_dbk(const H264Context *hc, H264SliceContext *sl, uint32_t w[5], int *bad)
+{
+    H264Context *h = (H264Context *)hc;
+    const int mb_xy = sl->mb_xy;
+    const int mb_type = h->cur_pic.mb_type[mb_xy];
+    const uint8_t *qs = h->cur_pic.qscale_table;
+    const uint8_t (*ct)[QP_MAX_NUM + 1] = h->ps.pps->chroma_qp_table;
+    uint8_t bs[2][4][4];                  // [dir][edge][segment]
+    uint32_t used = 0;
+    int dir, e, i;
+
+    *bad = 0;
+    if (!sl->deblocking_filter)
+        return 0;
+    if (FRAME_MBAFF(h) || FIELD_PICTURE(h) || h->pixel_shift || h->ps.sps->chroma_format_idc != 1) {
+        *bad = 1;
+        return 0;
+    }
+    if (fill_filter_caches(h, sl, mb_type))
+        return 0;                         // qp too low: nothing would change
+    memset(bs, 0, sizeof(bs));
+
+    for (dir = 0; dir < 2; dir++) {
+        const int mbm_type = dir ? sl->top_type : sl->left_type[LTOP];
+        const int step = dir ? 8 : 1;
+        // as filter_mb_dir: partitions with one vector along the edge
+        static const uint8_t mask_edge_tab[2][8] = { { 0, 3, 3, 3, 1, 1, 1, 1 },
+                                                     { 0, 3, 1, 1, 3, 3, 3, 3 } };
+        const int mask_edge = mask_edge_tab[dir][(mb_type >> 3) & 7];
+        const int edges = mask_edge == 3 && !(sl->cbp & 15) ? 1 : 4;
+        const int mask_par0 = mb_type & (MB_TYPE_16x16 | (MB_TYPE_8x16 >> dir));
+
+        // the macroblock edge
+        if (mbm_type) {
+            if (IS_INTRA(mb_type | mbm_type)) {
+                memset(bs[dir][0], 4, 4);
+            } else {
+                int mv_done = 0;
+                if (mask_par0 && (mbm_type & (MB_TYPE_16x16 | (MB_TYPE_8x16 >> dir)))) {
+                    memset(bs[dir][0], mcdbk_mv(sl, 12, 12 - step), 4);
+                    mv_done = 1;
+                }
+                for (i = 0; i < 4; i++) {
+                    int b = 12 + (dir ? i : 8 * i);
+                    if (sl->non_zero_count_cache[b] | sl->non_zero_count_cache[b - step])
+                        bs[dir][0][i] = 2;
+                    else if (!mv_done)
+                        bs[dir][0][i] = mcdbk_mv(sl, b, b - step);
+                }
+            }
+        }
+        // the edges inside
+        for (e = 1; e < edges; e++) {
+            if (IS_8x8DCT(mb_type) && (e & 1))
+                continue;
+            if (IS_INTRA(mb_type)) {
+                memset(bs[dir][e], 3, 4);
+                continue;
+            }
+            int mv_done = 0;
+            if (e & mask_edge) {
+                mv_done = 1;
+            } else if (mask_par0) {
+                int b = 12 + e * step;
+                memset(bs[dir][e], mcdbk_mv(sl, b, b - step), 4);
+                mv_done = 1;
+            }
+            for (i = 0; i < 4; i++) {
+                int b = 12 + (dir ? e * 8 + i : e + 8 * i);
+                if (sl->non_zero_count_cache[b] | sl->non_zero_count_cache[b - step])
+                    bs[dir][e][i] = 2;
+                else if (!mv_done)
+                    bs[dir][e][i] = mcdbk_mv(sl, b, b - step);
+            }
+        }
+    }
+    // the 32 strengths, 2 bits each (4, "strong", is in w[0]), and the edges used
+    for (dir = 0; dir < 2; dir++) {
+        uint32_t p = 0;
+        for (e = 0; e < 4; e++) {
+            uint32_t x = AV_RL32(bs[dir][e]);
+            if (!x)
+                continue;
+            used |= 1 << (dir * 4 + e);
+            x -= (x >> 2) & 0x01010101;        // 4 -> 3
+            p |= ((x | x >> 6 | x >> 12 | x >> 18) & 0xFF) << (e * 8);
+        }
+        w[3 + dir] = p;
+    }
+    if (!used)
+        return 0;
+
+    // qp: of the macroblock inside, the mean of the two macroblocks on its edges
+    int q = qs[mb_xy], qc0 = ct[0][q], qc1 = ct[1][q];
+    int qy[3] = { 0, 0, 0 }, qb[3] = { 0, 0, 0 }, qr[3] = { 0, 0, 0 };
+    for (dir = 0; dir < 2; dir++)
+        if (used & (1 << (dir * 4))) {
+            int n = qs[dir ? sl->top_mb_xy : mb_xy - 1];
+            qy[dir] = (q + n + 1) >> 1;
+            qb[dir] = (qc0 + ct[0][n] + 1) >> 1;
+            qr[dir] = (qc1 + ct[1][n] + 1) >> 1;
+        }
+    if (used & 0xEE)
+        qy[2] = q;
+    if (used & 0x44) {                    // chroma inside: luma edge 2 only
+        qb[2] = qc0;
+        qr[2] = qc1;
+    }
+    int offa = sl->slice_alpha_c0_offset, offb = sl->slice_beta_offset;
+    if (offa < -16 || offa > 15 || offb < -16 || offb > 15) {
+        *bad = 1;
+        return 0;
+    }
+    w[0] = 0xA5000000u | (bs[0][0][0] == 4) | (bs[1][0][0] == 4) << 1 |
+           (offa & 31) << 2 | (offb & 31) << 7;
+    w[1] = qy[0] | qy[1] << 6 | qy[2] << 12 | qb[0] << 18 | (uint32_t)qb[1] << 24;
+    w[2] = qb[2] | qr[0] << 6 | qr[1] << 12 | qr[2] << 18;
+    return 1;
+}
+
