# MiSTer MediaCenter changes to FFmpeg 6.1.2 (applied by build_ffmpeg.sh):
# - MC_PARSEONLY=1: the H.264 decoder reads the stream but does not rebuild
#   the pixels (measurement, mediacenter --bench-parse)
# - h264_mcacc.c: the FPGA accelerator, commands for the menu core (accel.c)
# - h264_mcdbk.c: deblocking parameters of each macroblock for the core (A5)
diff --git a/libavcodec/h264_loopfilter.c b/libavcodec/h264_loopfilter.c
index c164a28..dd9220b 100644
--- a/libavcodec/h264_loopfilter.c
+++ b/libavcodec/h264_loopfilter.c
@@ -102,6 +102,10 @@ static av_always_inline void filter_mb_edgev(uint8_t *pix, int stride,
                                              unsigned int qp, int a, int b,
                                              const H264Context *h, int intra)
 {
+    if (h->mcacc_dbk) { // MiSTer MediaCenter: note the edge only
+        ff_h264_mcdbk_edge(h->mcacc_dbk, pix, 0, bS, qp, a, b, intra);
+        return;
+    }
     const unsigned int index_a = qp + a;
     const int alpha = alpha_table[index_a];
     const int beta  = beta_table[qp + b];
@@ -124,6 +128,10 @@ static av_always_inline void filter_mb_edgecv(uint8_t *pix, int stride,
                                               unsigned int qp, int a, int b,
                                               const H264Context *h, int intra)
 {
+    if (h->mcacc_dbk) { // MiSTer MediaCenter: note the edge only
+        ff_h264_mcdbk_edge(h->mcacc_dbk, pix, 1, bS, qp, a, b, intra);
+        return;
+    }
     const unsigned int index_a = qp + a;
     const int alpha = alpha_table[index_a];
     const int beta  = beta_table[qp + b];
@@ -192,6 +200,10 @@ static av_always_inline void filter_mb_edgeh(uint8_t *pix, int stride,
                                              unsigned int qp, int a, int b,
                                              const H264Context *h, int intra)
 {
+    if (h->mcacc_dbk) { // MiSTer MediaCenter: note the edge only
+        ff_h264_mcdbk_edge(h->mcacc_dbk, pix, 2, bS, qp, a, b, intra);
+        return;
+    }
     const unsigned int index_a = qp + a;
     const int alpha = alpha_table[index_a];
     const int beta  = beta_table[qp + b];
@@ -214,6 +226,10 @@ static av_always_inline void filter_mb_edgech(uint8_t *pix, int stride,
                                               unsigned int qp, int a, int b,
                                               const H264Context *h, int intra)
 {
+    if (h->mcacc_dbk) { // MiSTer MediaCenter: note the edge only
+        ff_h264_mcdbk_edge(h->mcacc_dbk, pix, 3, bS, qp, a, b, intra);
+        return;
+    }
     const unsigned int index_a = qp + a;
     const int alpha = alpha_table[index_a];
