@@ -2480,6 +2485,22 @@ static void predict_field_decoding_flag(const H264Context *h, H264SliceContext *
     sl->mb_mbaff    = sl->mb_field_decoding_flag = IS_INTERLACED(mb_type) ? 1 : 0;
 }
 
+#include "h264_mcdbk.c"
+
+/* MiSTer MediaCenter, measurement only: with MC_PARSEONLY=1 the decoder reads
+ * the stream (CABAC/CAVLC, macroblock modes, motion vectors, coefficients)
+ * but does not rebuild the pixels, to time what the ARM would still do if an
+ * FPGA rebuilt them. The pictures it outputs are not meant to be shown. */
+static int mc_parse_only(void)
+{
+    static int v = -1;
+    if (v < 0) {
+        const char *e = getenv("MC_PARSEONLY");
+        v = e && *e && *e != '0';
+    }
+    return v;
+}
+
 /**
  * Draw edges and report progress for the last MB row.
  */
