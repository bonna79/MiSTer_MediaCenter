@@ -2595,7 +2620,9 @@ static int decode_slice(struct AVCodecContext *avctx, void *arg)
 
                 ret = ff_h264_decode_mb_cabac(h, sl);
 
-                if (ret >= 0)
+                if (ret >= 0 && h->mcacc_on)
+                    mcacc_mb(h, sl);
+                else if (ret >= 0 && !mc_parse_only())
                     ff_h264_hl_decode_mb(h, sl);
                 sl->mb_y--;
             }
@@ -2657,7 +2684,9 @@ static int decode_slice(struct AVCodecContext *avctx, void *arg)
 
             ret = ff_h264_decode_mb_cavlc(h, sl);
 
-            if (ret >= 0)
+            if (ret >= 0 && h->mcacc_on)
+                mcacc_mb(h, sl);
+            else if (ret >= 0 && !mc_parse_only())
                 ff_h264_hl_decode_mb(h, sl);
 
             // FIXME optimal? or let mb_decode decode 16x32 ?
@@ -2665,7 +2694,9 @@ static int decode_slice(struct AVCodecContext *avctx, void *arg)
                 sl->mb_y++;
                 ret = ff_h264_decode_mb_cavlc(h, sl);
 
-                if (ret >= 0)
+                if (ret >= 0 && h->mcacc_on)
+                    mcacc_mb(h, sl);
+                else if (ret >= 0 && !mc_parse_only())
                     ff_h264_hl_decode_mb(h, sl);
