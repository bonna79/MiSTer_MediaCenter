diff --git a/libavcodec/h264_mcacc.c b/libavcodec/h264_mcacc.c
new file mode 100644
index 0000000..e0f1507
--- /dev/null
+++ b/libavcodec/h264_mcacc.c
@@ -0,0 +1,245 @@
+/* MiSTer MediaCenter FPGA accelerator (included by h264_slice.c).
+ *
+ * When the player sets mc_acc_hooks (and gives its own decoder context as
+ * hooks->opaque), the H.264 decoder only reads the stream: for every picture
+ * it writes the commands of the MediaCenter FPGA engine (accel/doc/comandi.md
+ * in the MiSTer MediaCenter repository) into a buffer the player gives it,
+ * and does not rebuild the pixels; the FPGA does. Progressive 8-bit 4:2:0
+ * frames only: anything else calls hooks->fail and the player goes back to
+ * the normal decoder.
+ *
+ * The coefficients are taken from sl->mb and the blocks are cleared here, as
+ * the pixel rebuild would do. */
+
+struct mc_acc_pic {
+    uint32_t *p, *end;           // where the next word goes, end of the buffer
+};
+
+struct mc_acc_hooks {
+    void *opaque;                // the player's AVCodecContext->opaque
+    // a picture starts (decode order): its buffer, with the picture command written
+    struct mc_acc_pic *(*begin)(void *opaque, const AVFrame *f, int mb_w, int mb_h);
+    // at least `words` free words in the buffer
+    void (*grow)(void *opaque, struct mc_acc_pic *pic, int words);
+    // the picture's commands are all written (the last is the end of picture)
+    void (*end)(void *opaque, struct mc_acc_pic *pic);
+    // the slot of a reference picture
+    int (*slot)(void *opaque, const AVFrame *f);
+    // the stream cannot be done by the FPGA
+    void (*fail)(void *opaque, const char *why);
+    // the core filters the pictures (deblocking, command A5): set by the
+    // player when the core says so and MC_NODEBLOCK is not set
+    int deblock;
+};
+
+struct mc_acc_hooks *mc_acc_hooks;
+
+static int mcacc_for(const H264Context *h)
+{
+    return mc_acc_hooks && h->avctx->opaque && h->avctx->opaque == mc_acc_hooks->opaque;
+}
+
+static av_always_inline void mcacc_w(struct mc_acc_pic *pic, uint32_t w)
+{
+    *pic->p++ = w;
+}
+
+static void mcacc_room(struct mc_acc_pic *pic, int words)
+{
+    if (pic->end - pic->p < words)
+        mc_acc_hooks->grow(mc_acc_hooks->opaque, pic, words);
+}
+
+void ff_h264_mcacc_end(H264Context *h);
+
+static void mcacc_begin(H264Context *h)
+{
+    // a picture never ended (a missing frame made up by the decoder): end it
+    ff_h264_mcacc_end(h);
+    h->mcacc_on = mcacc_for(h);
+    if (!h->mcacc_on)
+        return;
+    if (h->picture_structure != PICT_FRAME || FRAME_MBAFF(h) || h->pixel_shift ||
+        h->ps.sps->chroma_format_idc != 1) {
+        mc_acc_hooks->fail(mc_acc_hooks->opaque, "interlaced, 4:2:2/4:4:4 or more than 8 bits");
+        return;
+    }
+    h->mcacc = mc_acc_hooks->begin(mc_acc_hooks->opaque, h->cur_pic_ptr->f, h->mb_width, h->mb_height);
+}
+
+void ff_h264_mcacc_end(H264Context *h)
+{
+    struct mc_acc_pic *pic = h->mcacc;
+    if (!pic)
+        return;
+    h->mcacc = NULL;
+    if (!mc_acc_hooks)
+        return;
+    mcacc_room(pic, 2);
+    mcacc_w(pic, 0xA4000000u);
+    mc_acc_hooks->end(mc_acc_hooks->opaque, pic);
+}
+
+static void mcacc_slice(const H264Context *h, const H264SliceContext *sl)
+{
+    struct mc_acc_pic *pic = h->mcacc;
+    if (!pic)
+        return;
+    mcacc_room(pic, 1 + 3 * 64);
+    mcacc_w(pic, 0xA2000000u | sl->ref_count[0] | sl->ref_count[1] << 6 |
+            (sl->list_count > 1) << 12 | sl->pwt.use_weight << 13 | sl->pwt.use_weight_chroma << 15 |
+            sl->pwt.luma_log2_weight_denom << 16 | sl->pwt.chroma_log2_weight_denom << 20);
+    for (int l = 0; l < sl->list_count; l++)
+        for (unsigned i = 0; i < sl->ref_count[l]; i++) {
+            const H264Ref *r = &sl->ref_list[l][i];
+            int slot = r->parent ? mc_acc_hooks->slot(mc_acc_hooks->opaque, r->parent->f) : 255;
+            // weights are 9 bits (the default 1 << denom can be 128), offsets 8
+            mcacc_w(pic, (slot & 0xFF) | (sl->pwt.luma_weight[i][l][0] & 0x1FF) << 8 |
+                    (sl->pwt.luma_weight[i][l][1] & 0xFF) << 17);
+            mcacc_w(pic, (sl->pwt.chroma_weight[i][l][0][0] & 0x1FF) | (sl->pwt.chroma_weight[i][l][0][1] & 0xFF) << 9);
+            mcacc_w(pic, (sl->pwt.chroma_weight[i][l][1][0] & 0x1FF) | (sl->pwt.chroma_weight[i][l][1][1] & 0xFF) << 9);
+        }
+}
+
+// the non-zero coefficients of a 4x4 block (FFmpeg keeps it transposed),
+// in raster order; the block is cleared
+static av_always_inline int mcacc_blk4(uint32_t *out, int16_t *c, int b)
+{
+    uint64_t a = AV_RN64A(c), b1 = AV_RN64A(c + 4), b2 = AV_RN64A(c + 8), b3 = AV_RN64A(c + 12);
+    int n = 0;
+    if (!(a | b1 | b2 | b3))
+        return 0;
+    for (int p = 0; p < 16; p++) {
+        int v = c[(p & 3) << 2 | p >> 2];
+        if (v)
+            out[n++] = (v & 0xFFFF) | p << 16 | b << 22;
+    }
+    AV_ZERO128(c);
+    AV_ZERO128(c + 8);
+    return n;
+}
+
+static int mcacc_dbk(const H264Context *hc, H264SliceContext *sl, uint32_t w[5], int *bad);
+
+// The deblocking command A5 of the macroblock, in the 5 words kept for it
+// before its A3; padding when it has nothing to filter. Called once the
+// macroblock's commands are written: FFmpeg's loop filter, run here in
+// "capture" mode, overwrites the slice's decoding caches (as between two
+// macroblock rows of a normal decode; the next macroblock fills them again).
+static void mcacc_dbk_put(const H264Context *h, H264SliceContext *sl, uint32_t *dw)
+{
+    int bad;
+    if (!mcacc_dbk(h, sl, dw, &bad) || bad)  // bad: never seen, left unfiltered
+        for (int i = 0; i < 5; i++)
+            dw[i] = 0xA0000000u;
+}
+
+static void mcacc_mb(const H264Context *h, H264SliceContext *sl)
+{
+    struct mc_acc_pic *pic = h->mcacc;
+    if (!pic)
+        return;
+    const int mb_type = h->cur_pic.mb_type[sl->mb_xy];
+    int16_t *mb = (int16_t *)sl->mb;
+    int type, i, n = 0;
+    uint32_t mask = 0, *coef, *head, *dw = NULL;
+
+    if (IS_INTRA_PCM(mb_type)) type = 4;
+    else if (IS_INTRA16x16(mb_type)) type = 3;
+    else if (IS_INTRA4x4(mb_type)) type = IS_8x8DCT(mb_type) ? 2 : 1;
+    else type = 0;
+
+    // at most: the deblocking command (5 words), 38 words, the count, 384 coefficients
+    mcacc_room(pic, 429);
+    if (mc_acc_hooks->deblock && sl->deblocking_filter) {
+        dw = pic->p;
+        pic->p += 5;
+    }
+    mcacc_w(pic, 0xA3000000u | type << 16 | sl->mb_y << 8 | sl->mb_x);
+    if (type == 4) {
+        for (i = 0; i < 384; i += 4)
+            mcacc_w(pic, AV_RL32(sl->intra_pcm_ptr + i));
+        if (dw)
+            mcacc_dbk_put(h, sl, dw);
+        return;
+    }
+    head = pic->p;                     // the mask goes here
+    pic->p += type ? 5 : 37;           // the mask, then the modes or vectors
+    coef = pic->p + 1;                 // then the count and the coefficients
+
+    // the DC transforms FFmpeg does while rebuilding (cheap, done by the ARM),
+    // in place as FFmpeg does
+    if (type == 3 && sl->non_zero_count_cache[scan8[LUMA_DC_BLOCK_INDEX]])
+        h->h264dsp.h264_luma_dc_dequant_idct(mb, sl->mb_luma_dc[0],
+                                             h->ps.pps->dequant4_coeff[0][sl->qscale][0]);
+    if (sl->cbp & 0x30) {
+        if (sl->non_zero_count_cache[scan8[CHROMA_DC_BLOCK_INDEX + 0]])
+            h->h264dsp.h264_chroma_dc_dequant_idct(mb + 256, h->ps.pps->dequant4_coeff[IS_INTRA(mb_type) ? 1 : 4][sl->chroma_qp[0]][0]);
+        if (sl->non_zero_count_cache[scan8[CHROMA_DC_BLOCK_INDEX + 1]])
+            h->h264dsp.h264_chroma_dc_dequant_idct(mb + 512, h->ps.pps->dequant4_coeff[IS_INTRA(mb_type) ? 2 : 5][sl->chroma_qp[1]][0]);
+    }
+
+    // luma: only the 8x8 quarters with coefficients (all four for intra 16x16)
+    if (IS_8x8DCT(mb_type)) {
+        for (int q = 0; q < 4; q++) {
+            int16_t *c = mb + q * 64;
+            int m = 0;
+            if (!(sl->cbp & (1 << q)))
+                continue;
+            for (int p = 0; p < 64; p++) {
+                int v = c[(p & 7) << 3 | p >> 3];
+                if (v) { coef[n++] = (v & 0xFFFF) | p << 16 | (q * 4) << 22; m = 1; }
+            }
+            mask |= m << (q * 4);
+            memset(c, 0, 128);
+        }
+    } else {
+        int q8 = type == 3 ? 15 : sl->cbp & 15;
+        for (int b = 0; b < 16; b++) {
+            int k;
+            if (!(q8 & (1 << (b >> 2))))
+                continue;
+            k = mcacc_blk4(coef + n, mb + b * 16, b);
+            if (k) { n += k; mask |= 1 << b; }
+        }
+    }
+    // chroma
+    if (sl->cbp & 0x30)
+        for (int b = 16; b < 24; b++) {
+            int k = mcacc_blk4(coef + n, mb + 256 + (b - 16) * 16 + (b >= 20 ? 192 : 0), b);
+            if (k) { n += k; mask |= 1 << b; }
+        }
+
+    head[0] = mask | (IS_8x8DCT(mb_type) ? 1u : 0u) << 24;
+    if (type) {
+        uint32_t m0 = 0, m1 = 0;
+        for (i = 0; i < 8; i++) m0 |= (sl->intra4x4_pred_mode_cache[scan8[i]] & 15) << (4 * i);
+        for (i = 0; i < 8; i++) m1 |= (sl->intra4x4_pred_mode_cache[scan8[i + 8]] & 15) << (4 * i);
+        if (type == 3) m0 = m1 = 0;
+        head[1] = m0;
+        head[2] = m1;
+        head[3] = (sl->topright_samples_available & 0xFFFF) | (sl->topleft_samples_available & 0xFFFF) << 16;
+        head[4] = sl->chroma_pred_mode | (type == 3 ? sl->intra16x16_pred_mode : 0) << 4;
+    } else {
+        for (i = 0; i < 4; i++) {
+            int r0 = USES_LIST(mb_type, 0) ? sl->ref_cache[0][scan8[i * 4]] : -1;
+            int r1 = sl->list_count > 1 && USES_LIST(mb_type, 1) ? sl->ref_cache[1][scan8[i * 4]] : -1;
+            uint32_t refs = (r0 & 0x3F) | (r0 < 0) << 6 | (uint32_t)((r1 & 0x3F) | (r1 < 0) << 6) << 7;
+            // both lists with implicit weights: weight of list 0 (list 1 is 64 - it)
+            if (r0 >= 0 && r1 >= 0 && sl->pwt.use_weight == 2)
+                refs |= (uint32_t)(sl->pwt.implicit_weight[r0][r1][sl->mb_y & 1] & 0x1FF) << 16;
+            else
+                refs |= 32u << 16;
+            head[1 + i] = refs;
+        }
+        for (int l = 0; l < 2; l++) {
+            int ok = l < sl->list_count && USES_LIST(mb_type, l);
+            for (i = 0; i < 16; i++)
+                head[5 + l * 16 + i] = ok ? (sl->mv_cache[l][scan8[i]][0] & 0xFFFF) | (uint32_t)sl->mv_cache[l][scan8[i]][1] << 16 : 0;
+        }
+    }
+    coef[-1] = n;
+    pic->p = coef + n;
+    if (dw)
+        mcacc_dbk_put(h, sl, dw);
+}
diff --git a/libavcodec/h264_mcdbk.c b/libavcodec/h264_mcdbk.c
new file mode 100644
index 0000000..6180903
--- /dev/null
+++ b/libavcodec/h264_mcdbk.c
@@ -0,0 +1,124 @@
+/* MiSTer MediaCenter FPGA accelerator: the deblocking parameters of one
+ * macroblock, for the FPGA command A5 (accel/doc/comandi.md in the MiSTer
+ * MediaCenter repository). Included by h264_slice.c after loop_filter().
+ *
+ * FFmpeg's own loop filter runs on the macroblock in "capture" mode
+ * (h->mcacc_dbk set): its edge functions note each edge (strength of the 4
+ * segments, qp, slice offsets) and touch no pixel, so the FPGA filters with
+ * exactly the strengths and qp FFmpeg would use. The decoding caches of the
+ * slice are overwritten (fill_filter_caches), as between two macroblock rows
+ * of a normal decode: call it after the macroblock's commands are written. */
+
+// edge functions of h264_loopfilter.c, in capture mode
+void ff_h264_mcdbk_edge(struct mc_dbk *d, const uint8_t *pix, int kind,
+                        const int16_t bS[4], int qp, int a, int b, int intra)
+{
+    int dir = kind >> 1, chroma = kind & 1, plane = 0, e, s;
+    ptrdiff_t off;
+    if (!chroma) {
+        off = pix - d->y;
+        e = (dir ? off / d->ls : off) / 4;
+    } else {
+        plane = pix >= d->cr ? 2 : 1;
+        off = pix - (plane == 2 ? d->cr : d->cb);
+        e = (dir ? off / d->uvls : off) / 4;      // 0 or 1 (luma edge 0 or 2)
+    }
+    if (e < 0 || e > (chroma ? 1 : 3) || off < 0) {
+        d->bad = 1;
+        return;
+    }
+    int cls = e ? 2 : dir;                        // 0 left, 1 top, 2 inside
+    if (d->qp[plane][cls] >= 0 && d->qp[plane][cls] != qp)
+        d->bad = 1;
+    d->qp[plane][cls] = qp;
+    if (d->n && (d->a != a || d->b != b))
+        d->bad = 1;
+    d->a = a;
+    d->b = b;
+    d->n++;
+    int strong = !e && intra && bS[0] == 4;
+    for (s = 0; s < 4; s++) {
+        int v = strong ? 4 : bS[s];
+        if (v < 0 || v > 4 || (v == 4 && !strong))
+            d->bad = 1;
+        if (chroma)
+            d->cbs[plane - 1][dir][e][s] = v;
+        else
+            d->bs[dir][e][s] = v;
+    }
+}
+
+/* The macroblock just read (sl->mb_xy): returns 1 and the 5 words of the
+ * command A5 if it has edges to filter, 0 if not. *bad is set when the
+ * parameters do not fit the command (never seen: the FPGA could not
+ * filter like FFmpeg). */
+static int mcacc_dbk(const H264Context *hc, H264SliceContext *sl, uint32_t w[5], int *bad)
+{
+    H264Context *h = (H264Context *)hc;   // only h->mcacc_dbk is changed
+    static uint8_t img[3 * 16 * 64];      // pointers only, never read or written
+    struct mc_dbk d;
+    const int mb_xy = sl->mb_xy;
+    const int mb_type = h->cur_pic.mb_type[mb_xy];
+    int p, dir, e, s, any = 0;
+
+    *bad = 0;
+    if (!sl->deblocking_filter)
+        return 0;
+    memset(&d, 0, sizeof(d));
+    memset(d.qp, -1, sizeof(d.qp));
+    d.y = img;
+    d.cb = img + 16 * 64;
+    d.cr = img + 2 * 16 * 64;
+    d.ls = d.uvls = 64;
+    if (fill_filter_caches(h, sl, mb_type))
+        return 0;                         // qp too low: nothing would change
+    sl->chroma_qp[0] = get_chroma_qp(h->ps.pps, 0, h->cur_pic.qscale_table[mb_xy]);
+    sl->chroma_qp[1] = get_chroma_qp(h->ps.pps, 1, h->cur_pic.qscale_table[mb_xy]);
+    h->mcacc_dbk = &d;
+    ff_h264_filter_mb_fast(h, sl, sl->mb_x, sl->mb_y, img, img + 16 * 64, img + 2 * 16 * 64, 64, 64);
+    h->mcacc_dbk = NULL;
+    sl->chroma_qp[0] = get_chroma_qp(h->ps.pps, 0, sl->qscale);
+    sl->chroma_qp[1] = get_chroma_qp(h->ps.pps, 1, sl->qscale);
+    if (!d.n)
+        return 0;
+
+    // chroma edges 0 and 1 go with luma edges 0 and 2: same strengths
+    for (p = 0; p < 2; p++)
+        for (dir = 0; dir < 2; dir++)
+            for (e = 0; e < 2; e++)
+                for (s = 0; s < 4; s++)
+                    if (d.cbs[p][dir][e][s] != d.bs[dir][2 * e][s])
+                        d.bad = 1;
+    // a 4 is only on a macroblock edge, on all of its segments
+    for (dir = 0; dir < 2; dir++)
+        for (e = 0; e < 4; e++)
+            for (s = 0; s < 4; s++) {
+                if (d.bs[dir][e][s] == 4 && (e || d.bs[dir][0][0] != 4))
+                    d.bad = 1;
+                any |= d.bs[dir][e][s];
+            }
+    int offa = d.a - 52, offb = d.b - 52;
+    if (offa < -16 || offa > 15 || offb < -16 || offb > 15)
+        d.bad = 1;
+    for (p = 0; p < 3; p++)
+        for (e = 0; e < 3; e++)
+            if (d.qp[p][e] < 0)
+                d.qp[p][e] = 0;
+            else if (d.qp[p][e] > 51)
+                d.bad = 1;
+    *bad = d.bad;
+    if (!any)
+        return 0;
+
+    w[0] = 0xA5000000u | (d.bs[0][0][0] == 4) | (d.bs[1][0][0] == 4) << 1 |
+           (offa & 31) << 2 | (offb & 31) << 7;
+    w[1] = d.qp[0][0] | d.qp[0][1] << 6 | d.qp[0][2] << 12 | d.qp[1][0] << 18 | (uint32_t)d.qp[1][1] << 24;
+    w[2] = d.qp[1][2] | d.qp[2][0] << 6 | d.qp[2][1] << 12 | d.qp[2][2] << 18;
+    w[3] = w[4] = 0;
+    for (e = 0; e < 4; e++)
+        for (s = 0; s < 4; s++) {
+            w[3] |= (uint32_t)FFMIN(d.bs[0][e][s], 3) << ((e * 4 + s) * 2);
+            w[4] |= (uint32_t)FFMIN(d.bs[1][e][s], 3) << ((e * 4 + s) * 2);
+        }
+    return 1;
+}
